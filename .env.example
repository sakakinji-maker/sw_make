# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요. (.env는 Git에 올리지 않습니다)

# AI_PROVIDER: mock(개발·테스트용, 기본값) | groq | gemini | claude | openai
# 팀 결정: 11/10 Gemini 무료 등급 → 11/23 검증 실험부터 Groq(qwen/qwen3.8-27b) 사용. 평소에는 mock으로 개발합니다.
AI_PROVIDER=mock
# 실제 API를 쓸 때만 채웁니다. 키는 정회성이 관리하며 절대 공유·커밋하지 않습니다.
AI_API_KEY=
# 팀 사용 모델(11/10 확인): gemini-3.8-flash
# 실제 API를 쓸 때: AI_MODEL=gemini-3.8-flash
AI_MODEL=
# 응답 대기 시간(초)
AI_TIMEOUT=30
# 429(호출 한도 초과)·503일 때 다시 시도하는 횟수
AI_MAX_RETRIES=2

DATABASE_URL=sqlite:///./app/db/app.db

# 문자 알림: mock(기본값, 실제로 보내지 않고 로그만) | solapi(쿨SMS 실제 발송)
SMS_PROVIDER=mock
# 쿨SMS(solapi.com) 콘솔에서 발급. 절대 공유·커밋하지 않습니다.
SMS_API_KEY=
SMS_API_SECRET=
# 쿨SMS에 등록·인증한 발신번호 (숫자만 또는 하이픈 포함)
SMS_SENDER=
# 새 예약·새 문의 알림을 받을 점주 휴대폰 번호
SMS_OWNER_PHONE=
